rules_version = '2';

// Kriterin Mekan — "oylar" koleksiyonu kuralları
// Firebase Console → Firestore Database → Rules sekmesine yapıştırın.
//
// v1 modeli: giriş istemeden anonim oy. Alanlar sıkı doğrulanır; herkes
// okuyabilir ve oy ekleyebilir, silme kapalıdır. Kötüye kullanım artarsa
// bir üst adım Anonymous Authentication + request.auth kontrolüdür.
service cloud.firestore {
  match /databases/{database}/documents {
    match /oylar/{oyId} {
      allow read: if true;
      allow create, update: if
        request.resource.data.keys().hasOnly(['mekan', 'genel', 'priz', 'sessiz', 'calisma', 'cid', 't'])
        && request.resource.data.mekan is string
        && request.resource.data.mekan.size() > 0
        && request.resource.data.mekan.size() < 60
        && request.resource.data.cid is string
        && request.resource.data.cid.size() < 40
        && (!('genel' in request.resource.data)
            || (request.resource.data.genel is int
                && request.resource.data.genel >= 1
                && request.resource.data.genel <= 5))
        && (!('priz' in request.resource.data)    || request.resource.data.priz in ['yes', 'no'])
        && (!('sessiz' in request.resource.data)  || request.resource.data.sessiz in ['yes', 'no'])
        && (!('calisma' in request.resource.data) || request.resource.data.calisma in ['yes', 'no'])
        && (!('t' in request.resource.data)       || request.resource.data.t is int);
      allow delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
